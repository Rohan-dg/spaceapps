{
  "name": "lunar-site-compare",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "test": "vitest run",
    "validate": "NODE_USE_ENV_PROXY=1 tsx scripts/validate_horizons.ts",
