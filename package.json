    "demo-detail": "tsx scripts/demo_detail.ts",
    "desktop": "tauri dev",
    "desktop:build": "tauri build"
  },
  "dependencies": {
    "@types/three": "^0.187.0",
    "astronomy-engine": "^2.1.19",
